Options -Indexes
DirectoryIndex public/index.html index.html

# Deny direct web access to non-public application internals when the
# project root is inside the Apache document root (e.g. http://localhost/schoolguard/).
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^(config|includes|database|mobile)(/|$) - [F,L]

  # Existing files and folders (api/*.php, public/*, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Clean URLs: /schoolguard/css/app.css → public/css/app.css
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
